@{
    var success = TempData["Success"]?.ToString() ?? TempData["SuccessMessage"]?.ToString();
    var error = TempData["Error"]?.ToString() ?? TempData["ErrorMessage"]?.ToString();
}
@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error))
{
    <div class="cv-toast-host" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="cv-toast-item cv-toast-item--success" role="alert">
                <i class="fa-solid fa-circle-check cv-toast-icon" aria-hidden="true"></i>
                <span class="cv-toast-message">@success</span>
                <button type="button" class="cv-toast-close" aria-label="Dismiss">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="cv-toast-item cv-toast-item--error" role="alert">
                <i class="fa-solid fa-circle-exclamation cv-toast-icon" aria-hidden="true"></i>
                <span class="cv-toast-message">@error</span>
                <button type="button" class="cv-toast-close" aria-label="Dismiss">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>
}
