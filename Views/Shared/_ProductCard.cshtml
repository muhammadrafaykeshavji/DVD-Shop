@using E_project_DVD_Shop.Helpers
@using E_project_DVD_Shop.Models
@model E_project_DVD_Shop.Models.Entities.Product
@{
    var cover = ProductCatalogHelper.GetCoverUrl(Model) ?? "/images/placeholder-album.svg";
    var category = ProductCatalogHelper.GetCategoryName(Model);
    var title = ProductCatalogHelper.GetTitle(Model);
    var mediaType = ProductCatalogHelper.GetMediaType(Model);
    var returnUrl = ViewData["ReturnUrl"] as string;
    var tagClass = mediaType switch
    {
        MediaType.Movie => "cv-arrival-tag--movie",
        MediaType.Game => "cv-arrival-tag--game",
        _ => "cv-arrival-tag--music"
    };
}
<div class="cv-card cv-product-card h-100">
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none cv-product-card-link">
        <div class="cv-thumb">
            <span class="cv-arrival-tag @tagClass">@mediaType</span>
            <img src="@cover" alt="@title" onerror="this.src='/images/placeholder-album.svg'" />
        </div>
    </a>
    <div class="cv-card-body">
        <span class="cv-category">@category</span>
        <h6 class="cv-title">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none">@title</a>
        </h6>
        <p class="cv-artist mb-2">@ProductCatalogHelper.GetCreditName(Model)</p>
        <div class="d-flex justify-content-between align-items-center gap-1 flex-wrap">
            <span class="cv-price">$@Model.Price.ToString("F2")</span>
            @if (User.IsInRole("Member"))
            {
                <div class="d-flex gap-1">
                    <form asp-controller="Product" asp-action="AddToCart" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ProductId" />
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }
                        <button type="submit" class="btn btn-cv-primary btn-sm" title="Add to cart"><i class="fa-solid fa-cart-plus"></i></button>
                    </form>
                    <form asp-controller="Wishlist" asp-action="Add" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }
                        <button type="submit" class="btn btn-cv-ghost btn-sm" title="Add to wishlist"><i class="fa-regular fa-heart"></i></button>
                    </form>
                </div>
            }
            else
            {
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-cv-primary btn-sm">View</a>
            }
        </div>
    </div>
</div>
