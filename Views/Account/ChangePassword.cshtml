@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<div class="cv-member-dashboard" style="max-width:520px;">
    <section class="cv-dash-hero mb-4">
        <p class="cv-dash-eyebrow"><i class="fa-solid fa-key me-1"></i> Security</p>
        <h1 class="cv-dash-title">Change password</h1>
        <p class="cv-dash-sub mb-0">Use a strong password you do not reuse elsewhere.</p>
    </section>
    <div class="cv-dash-panel">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-cv-primary">Update password</button>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-cv-outline">Back to profile</a>
        </div>
    }
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
