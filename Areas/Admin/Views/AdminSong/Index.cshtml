@model PaginatedList<Song>
@{
    ViewData["Title"] = "Manage Song";
    ViewData["AdminTitle"] = "Manage Songs";
    const string entityLabel = "song";
}

@await Html.PartialAsync("_AdminPageHeader")

<div class="cv-admin-table-wrap">
    <div class="table-responsive">
        <table class="table cv-table cv-table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th class="cv-col-id">ID</th>
                    <th>Title</th>
                    <th>Album</th>
                    <th>Duration</th>
                    <th>Free</th>
                    <th class="text-end cv-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="cv-table-empty">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No songs yet. <a asp-action="Create">Add the first song</a>.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var mins = item.DurationSeconds / 60;
                        var secs = item.DurationSeconds % 60;
                        <tr>
                            <td><span class="cv-id-badge">@item.SongId</span></td>
                            <td class="text-white-cell">@item.Title</td>
                            <td>@item.Album?.Title</td>
                            <td>@($"{mins}:{secs:D2}")</td>
                            <td>
                                @if (item.IsFree)
                                {
                                    <span class="cv-status cv-status-delivered">Yes</span>
                                }
                                else
                                {
                                    <span class="text-cv-muted">No</span>
                                }
                            </td>
                            <td class="text-end">
                                @await Html.PartialAsync("_AdminTableActions", (item.SongId, entityLabel))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)
