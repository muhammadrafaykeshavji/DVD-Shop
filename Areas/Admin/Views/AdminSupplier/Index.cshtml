@model PaginatedList<Supplier>
@{
    ViewData["Title"] = "Manage Supplier";
    ViewData["AdminTitle"] = "Manage Suppliers";
    const string entityLabel = "supplier";
}

@await Html.PartialAsync("_AdminPageHeader")

<div class="cv-admin-table-wrap">
    <div class="table-responsive">
        <table class="table cv-table cv-table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th class="cv-col-id">ID</th>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th class="text-end cv-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="cv-table-empty">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No suppliers yet. <a asp-action="Create">Add the first supplier</a>.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="cv-id-badge">@item.SupplierId</span></td>
                            <td class="text-white-cell">@item.Name</td>
                            <td>@(item.Contact ?? "—")</td>
                            <td class="text-cv-secondary small">@(item.Address ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="cv-status cv-status-delivered">Active</span>
                                }
                                else
                                {
                                    <span class="cv-status cv-status-cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @await Html.PartialAsync("_AdminTableActions", (item.SupplierId, entityLabel))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)
