@model PurchasingInvoice
@{
    ViewData["Title"] = "Edit Invoice";
    ViewData["FormTitle"] = $"Edit Invoice #{Model.PurchasingInvoiceId}";
    ViewData["FormIcon"] = "fa-file-invoice";
    ViewData["SaveLabel"] = "Update Invoice";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card cv-admin-form-wide">
    <form asp-action="Edit" method="post" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PurchasingInvoiceId" />
        <div asp-validation-summary="ModelOnly"></div>
        @await Html.PartialAsync("_Form", Model)
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
