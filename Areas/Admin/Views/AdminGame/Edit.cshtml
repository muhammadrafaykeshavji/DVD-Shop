@model Game
@{
    ViewData["Title"] = "Edit Game";
    ViewData["FormTitle"] = $"Edit Game — {Model.Title}";
    ViewData["FormIcon"] = "fa-gamepad";
    ViewData["SaveLabel"] = "Update Game";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card cv-admin-form-wide">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="GameId" />
        <div asp-validation-summary="ModelOnly"></div>
        @await Html.PartialAsync("_Form", Model)
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
