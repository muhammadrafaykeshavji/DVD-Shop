@{
    var title = ViewData["FormTitle"] as string ?? ViewData["Title"]?.ToString() ?? "Form";
    var subtitle = ViewData["FormSubtitle"] as string;
    var icon = ViewData["FormIcon"] as string ?? "fa-pen-to-square";
}
<header class="cv-admin-form-header">
    <a asp-action="Index" class="cv-admin-back-link">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to list
    </a>
    <h1 class="cv-dash-title mt-2 mb-0">
        <i class="fa-solid @icon me-2 text-cv-gold"></i>@title
    </h1>
    @if (!string.IsNullOrEmpty(subtitle))
    {
        <p class="cv-dash-sub mb-0 mt-1">@subtitle</p>
    }
</header>
