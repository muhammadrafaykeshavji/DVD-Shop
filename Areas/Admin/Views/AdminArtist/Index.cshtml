@model PaginatedList<Artist>
@{
    ViewData["Title"] = "Manage Artists";
    ViewData["AdminTitle"] = "Manage Artists (Singers)";
    const string entityLabel = "artist";
}

@await Html.PartialAsync("_AdminPageHeader")

<form method="get" asp-action="Index" class="cv-admin-filters cv-dash-panel cv-admin-filters-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4 col-lg-5">
            <label class="form-label small text-cv-secondary mb-1">Search</label>
            <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Singer / composer name..." />
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-cv-primary"><i class="fa-solid fa-filter me-1"></i> Apply</button>
            <a asp-action="Index" class="btn btn-cv-outline">Clear</a>
        </div>
    </div>
</form>

<div class="cv-admin-table-wrap">
    <div class="table-responsive">
        <table class="table cv-table cv-table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th class="cv-col-id">ID</th>
                    <th style="width: 56px;"></th>
                    <th>Name</th>
                    <th>Bio</th>
                    <th class="text-end cv-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="cv-table-empty">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No artists yet. <a asp-action="Create">Add the first artist</a>.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="cv-id-badge">@item.ArtistId</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="cv-table-thumb" onerror="this.onerror=null;this.src='/images/placeholder-album.svg';" />
                                }
                                else
                                {
                                    <span class="cv-table-thumb-placeholder"><i class="fa-solid fa-user"></i></span>
                                }
                            </td>
                            <td class="text-white-cell">@item.Name</td>
                            <td class="text-cv-secondary small">
                                @if (string.IsNullOrWhiteSpace(item.Bio))
                                {
                                    <span class="text-cv-muted">—</span>
                                }
                                else
                                {
                                    @(item.Bio.Length > 100 ? item.Bio[..100] + "…" : item.Bio)
                                }
                            </td>
                            <td class="text-end">
                                @await Html.PartialAsync("_AdminTableActions", (item.ArtistId, entityLabel))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)
