@model Album
@{
    ViewData["Title"] = "Create Album";
    ViewData["FormTitle"] = "Add New Album";
    ViewData["FormIcon"] = "fa-compact-disc";
    ViewData["SaveLabel"] = "Create Album";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card cv-admin-form-wide">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @await Html.PartialAsync("_Form", Model)
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
    <script>
        (function () {
            var range = document.querySelector('.cv-banner-vis-range');
            var label = document.querySelector('.cv-banner-vis-value');
            if (!range || !label) return;
            range.addEventListener('input', function () { label.textContent = range.value + '%'; });
        })();
    </script>
}
