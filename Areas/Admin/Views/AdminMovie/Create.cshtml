@model Movie
@{
    ViewData["Title"] = "Create Movie";
    ViewData["FormTitle"] = "Add New Movie";
    ViewData["FormIcon"] = "fa-film";
    ViewData["SaveLabel"] = "Create Movie";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card cv-admin-form-wide">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        @await Html.PartialAsync("_Form", Model)
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
