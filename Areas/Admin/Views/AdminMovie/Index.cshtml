@model PaginatedList<Movie>
@{
    ViewData["Title"] = "Manage Movie";
    ViewData["AdminTitle"] = "Manage Movies";
    const string entityLabel = "movie";
}

@await Html.PartialAsync("_AdminPageHeader")

<div class="cv-admin-table-wrap">
    <div class="table-responsive">
        <table class="table cv-table cv-table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th class="cv-col-id">ID</th>
                    <th>Title</th>
                    <th>Studio</th>
                    <th>Category</th>
                    <th>Trailer</th>
                    <th class="text-end cv-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="cv-table-empty">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No movies yet. <a asp-action="Create">Add the first movie</a>.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="cv-id-badge">@item.MovieId</span></td>
                            <td class="text-white-cell">@item.Title</td>
                            <td>@item.FilmStudio?.Name</td>
                            <td>@item.Category?.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PreviewUrl))
                                {
                                    <span class="text-cv-gold small"><i class="fa-solid fa-play"></i> Yes</span>
                                }
                                else { <span class="text-cv-muted">—</span> }
                            </td>
                            <td class="text-end">
                                @await Html.PartialAsync("_AdminTableActions", (item.MovieId, entityLabel))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)
