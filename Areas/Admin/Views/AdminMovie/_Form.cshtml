@model Movie
@{
    var isEdit = Model?.MovieId > 0;
    var filmStudioId = ViewBag.FilmStudioId as SelectList;
    var categoryId = ViewBag.CategoryId as SelectList;
    var releaseDate = ViewBag.ReleaseDate as string ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
    var dvdCover = ViewBag.DvdCoverUrl as string;
}
<div class="cv-product-form-help mb-4">
    <i class="fa-solid fa-film text-cv-gold me-2"></i>
    <div>
        <strong>Movie DVDs</strong>
        <p class="mb-0 small text-cv-secondary">Add movies here — not on the Music Albums page. After saving, set price &amp; stock under <strong>Products</strong>.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label">Movie title</label>
        <input asp-for="Title" class="form-control" placeholder="e.g. The Dark Knight" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label">Release date</label>
        <input type="date" name="releaseDate" class="form-control" value="@releaseDate" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Studio</label>
        <select name="filmStudioId" class="form-select" asp-items="filmStudioId">
            <option value="">— Select studio —</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select" asp-items="categoryId">
            <option value="">— Select category —</option>
        </select>
    </div>
    @if (isEdit)
    {
        <input type="hidden" asp-for="MovieId" />
    }
    <div class="col-12">
        <label class="form-label">DVD poster URL</label>
        <input type="text" name="dvdCoverUrl" class="form-control" value="@dvdCover" placeholder="https://example.com/poster.jpg" />
        <label class="form-label mt-2">Or upload poster</label>
        <input type="file" name="dvdCoverFile" class="form-control" accept="image/*" />
    </div>
    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label">Wide landscape banner (product page background)</label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/wide-banner.jpg" />
        <span class="field-hint">Wide promo art — shown blurred behind the product page.</span>
        <label class="form-label mt-2">Or upload banner</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
    </div>
    <div class="col-12">
        <label asp-for="PreviewUrl" class="form-label">Trailer URL</label>
        <input asp-for="PreviewUrl" class="form-control" placeholder="https://…" />
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label">Synopsis</label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Movie synopsis…"></textarea>
    </div>
</div>
