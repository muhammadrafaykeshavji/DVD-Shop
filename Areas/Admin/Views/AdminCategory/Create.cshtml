@model Category
@{
    ViewData["Title"] = "Create Category";
    ViewData["FormTitle"] = "Add New Category";
    ViewData["FormIcon"] = "fa-tags";
    ViewData["SaveLabel"] = "Create Category";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card">
    <form asp-action="Create" method="post" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Category name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
