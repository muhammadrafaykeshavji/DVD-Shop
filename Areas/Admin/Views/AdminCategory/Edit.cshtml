@model Category
@{
    ViewData["Title"] = "Edit Category";
    ViewData["FormTitle"] = $"Edit Category — {Model.Name}";
    ViewData["FormIcon"] = "fa-tags";
    ViewData["SaveLabel"] = "Update Category";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card">
    <form asp-action="Edit" method="post" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CategoryId" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
