@model MusicStudio
@{
    var isEdit = Model?.MusicStudioId > 0;
}
<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Atlantic Records" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Bio" class="form-label"></label>
        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Record label description…"></textarea>
    </div>
    <div class="col-12">
        @if (isEdit && !string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="cv-form-preview mb-2">
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            </div>
        }
        <label asp-for="ImageUrl" class="form-label">Image URL</label>
        <input asp-for="ImageUrl" class="form-control" />
        <label class="form-label mt-3">Or upload image</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
    </div>
</div>

