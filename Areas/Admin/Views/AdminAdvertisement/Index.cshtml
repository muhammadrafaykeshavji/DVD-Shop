@model PaginatedList<Advertisement>
@{
    ViewData["Title"] = "Manage Advertisement";
    ViewData["AdminTitle"] = "Manage Banners";
    const string entityLabel = "banner";
}

@await Html.PartialAsync("_AdminPageHeader")

<div class="cv-admin-table-wrap">
    <div class="table-responsive">
        <table class="table cv-table cv-table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th class="cv-col-id">ID</th>
                    <th style="width: 72px;">Preview</th>
                    <th>Position</th>
                    <th>Link</th>
                    <th>Status</th>
                    <th class="text-end cv-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="cv-table-empty">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                            No banners yet. <a asp-action="Create">Add the first banner</a>.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="cv-id-badge">@item.AdId</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Banner @item.AdId" class="cv-table-thumb cv-table-thumb-wide" />
                                }
                                else
                                {
                                    <span class="cv-table-thumb-placeholder cv-table-thumb-wide"><i class="fa-solid fa-image"></i></span>
                                }
                            </td>
                            <td><span class="cv-badge-gold">@item.Position</span></td>
                            <td class="text-cv-secondary small text-truncate" style="max-width: 200px;">
                                @if (string.IsNullOrEmpty(item.LinkUrl))
                                {
                                    <span class="text-cv-muted">—</span>
                                }
                                else
                                {
                                    <a href="@item.LinkUrl" target="_blank" rel="noopener" class="text-cv-gold">@item.LinkUrl</a>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="cv-status cv-status-delivered">Active</span>
                                }
                                else
                                {
                                    <span class="cv-status cv-status-cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @await Html.PartialAsync("_AdminTableActions", (item.AdId, entityLabel))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)
