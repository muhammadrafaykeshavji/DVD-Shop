@model Review
@{
    ViewData["Title"] = "Create Review";
    ViewData["FormTitle"] = "Add Review";
    ViewData["FormIcon"] = "fa-star";
    ViewData["SaveLabel"] = "Save Review";
}

@await Html.PartialAsync("_AdminFormHeader")

<div class="cv-dash-panel cv-admin-form-card">
    <form asp-action="Create" method="post" class="cv-admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <p class="text-cv-secondary small">Manual review entry — ensure the Create action is enabled in the admin controller if you use this page.</p>
        <div class="row g-4 mt-1">
            <div class="col-md-4">
                <label asp-for="Rating" class="form-label"></label>
                <select asp-for="Rating" class="form-select">
                    @for (var i = 1; i <= 5; i++) { <option value="@i">@i</option> }
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
            </div>
        </div>
        @await Html.PartialAsync("_AdminFormFooter")
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_AdminFormScripts")
}
